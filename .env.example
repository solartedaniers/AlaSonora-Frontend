# Cuenta de ejemplo del login: npm run build la inyecta como placeholder (scripts/build.mjs).
# Vacías o ausentes: el login muestra los placeholders genéricos y el build no falla.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Origen público (p. ej. https://alasonora.com): lo uso para canonical, og:url, robots.txt y sitemap.xml.
# Si está vacío o es inválido, el build los omite y no falla.
SITE_URL=
